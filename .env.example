# ===== LBank Futures Position Widget (READ-ONLY) =====
# Copy to .env and fill in values. NEVER commit your real .env.

# Mock mode is the FIRST-VERSION main line. Keep true unless you have
# verified real read-only Futures endpoints.
LBANK_WIDGET_MOCK_MODE=true

# API credentials. The key MUST be configured as READ-ONLY on LBank.
# Do NOT grant trading or withdrawal permissions.
LBANK_API_KEY=
# Secret only ever lives in the backend. It must never appear in any
# API response, log, frontend bundle, or git repo.
LBANK_API_SECRET=

LBANK_SIGNATURE_METHOD=HmacSHA256

# Perpetual/Futures base URL is config-driven. Real calls go through an
# adapter + TODO until the endpoints are verified against LBank docs.
LBANK_BASE_URL=https://lbkperp.lbank.com/

# SQLite path for display-only widget settings.
LBANK_DB_URL=sqlite:///./lbank_widget.db
